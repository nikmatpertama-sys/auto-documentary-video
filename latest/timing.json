  "caption_groups": [
    {
      "start": 0.852083,
      "end": 2.9093739999999997,
      "text": "Tiny white ant eggs are carefully tended"
    },
    {
      "start": 2.935416,
      "end": 4.927624000000001,
      "text": "by worker ants within the hidden depths"
    },
    {
      "start": 4.953666,
      "end": 6.438041,
      "text": "of the dark underground nest."
    },
    {
      "start": 8.176083,
      "end": 10.012041,
      "text": "Hatching from these fragile eggs emerge"
    },
    {
      "start": 10.038083,
      "end": 12.538083,
      "text": "legless larvae that rely entirely on adults"
    },
    {
      "start": 12.551083,
      "end": 14.334958,
      "text": "for constant nourishment and care."
    },
    {
      "start": 15.676083000000002,
      "end": 17.381833000000004,
      "text": "During the resting pupal stage,"
    },
    {
      "start": 17.564125,
      "end": 20.012041000000004,
      "text": "the motionless insect undergoes a remarkable"
    },
    {
      "start": 20.025041,
      "end": 22.512041,
      "text": "internal transformation into an adult form."
    },
    {
      "start": 23.848083000000003,
      "end": 25.9705,
      "text": "Newly emerged adult workers begin their"
    },
    {
      "start": 25.996541,
      "end": 28.092874000000002,
      "text": "lives inside the subterranean nest by"
    },
    {
      "start": 28.118916000000002,
      "end": 30.280416000000002,
      "text": "performing essential maintenance and nursery"
    },
    {
      "start": 30.293416,
      "end": 30.814249,
      "text": "duties."
    },
    {
      "start": 32.140083000000004,
      "end": 33.59845800000001,
      "text": "As these workers grow older,"
    },
    {
      "start": 33.780708000000004,
      "end": 35.746875,
      "text": "they transition to foraging outside for"
    },
    {
      "start": 35.772916,
      "end": 37.85625,
      "text": "vital resources to sustain the entire"
    },
    {
      "start": 37.882291,
      "end": 38.754666,
      "text": "growing colony."
    },
    {
      "start": 40.096083,
      "end": 41.567458,
      "text": "Within the heart of the community,"
    },
    {
      "start": 41.788791,
      "end": 43.754957000000005,
      "text": "the specialized queen remains focused"
    },
    {
      "start": 43.781,
      "end": 46.098707999999995,
      "text": "primarily on continuous egg production and"
    },
    {
      "start": 46.12475,
      "end": 47.192458,
      "text": "colony expansion."
    },
    {
      "start": 48.53208299999999,
      "end": 50.706582999999995,
      "text": "Mature colonies eventually produce winged"
    },
    {
      "start": 50.73262499999999,
      "end": 52.54254099999999,
      "text": "reproductives that prepare to leave the"
    },
    {
      "start": 52.568540999999996,
      "end": 54.83416599999999,
      "text": "natal nest during seasonal mating flights."
    },
    {
      "start": 56.15208299999999,
      "end": 58.482832999999985,
      "text": "Successful mated females shed their wings to"
    },
    {
      "start": 58.49583299999999,
      "end": 60.64429099999999,
      "text": "establish brand new foundations and begin"
    },
    {
      "start": 60.67033299999999,
      "end": 62.03749899999999,
      "text": "the intricate cycle anew."
    }
  ],
