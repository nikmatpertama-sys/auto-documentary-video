  "caption_groups": [
    {
      "start": 0.852083,
      "end": 2.622916,
      "text": "Deep within cold clouds of gas,"
    },
    {
      "start": 2.844291,
      "end": 4.758374,
      "text": "new stars slowly awaken to light up"
    },
