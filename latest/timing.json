  "caption_groups": [
    {
      "start": 0.852083,
      "end": 3.156791,
      "text": "Beavers live in freshwater ecosystems such"
    },
    {
      "start": 3.169791,
      "end": 5.760958,
      "text": "as rivers, streams, lakes and ponds across"
    },
    {
      "start": 5.773958,
      "end": 6.893790999999999,
      "text": "various landscapes."
    },
    {
      "start": 8.608083,
      "end": 10.457041,
      "text": "In Europe, beavers were reduced to"
    },
    {
      "start": 10.470083,
      "end": 12.488291,
      "text": "fragmented populations with combined"
    },
    {
      "start": 12.501333,
      "end": 14.506541,
      "text": "population numbers being estimated."
    },
    {
      "start": 15.820083,
      "end": 17.786249,
      "text": "These historical reductions affected"
    },
    {
      "start": 17.812291000000002,
      "end": 20.064916,
      "text": "populations within regions like the Rhône of"
    },
    {
      "start": 20.090916,
      "end": 21.158624,
      "text": "France and the Elbe."
    },
    {
